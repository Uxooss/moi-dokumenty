{
  "name": "moi-dokumenty",
  "version": "1.0.0",
  "description": "Мої Докі - Офлайн архів сертифікатів, ліцензій та посвідчень",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "com.moidokumenty.app",
    "productName": "Мої Докі",
